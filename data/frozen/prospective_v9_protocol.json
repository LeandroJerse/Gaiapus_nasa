  "scoring": {
    "when": "once, after the first PAM release of the harvest",
    "pairing": "keys with predictions from every compared model; cutoffs averaged per harvest before averaging harvests",
    "weighting": "MG+MT scopes 50% per state; other scopes harvest-weighted",
    "uncertainty": "bootstrap of municipalities stratified by state, 2,000 draws; one season shares weather shocks, so the CI is conditional on the season"
  },
  "approval_for_operational_use": {
    "requires_all": [
      "relative MAE gain >= 5% against EVERY registered simple reference of the crop (history_ref and the published references), CI95 upper bound of the MAE difference < 0 for each, Holm-adjusted across the candidates of the same crop x scope",
