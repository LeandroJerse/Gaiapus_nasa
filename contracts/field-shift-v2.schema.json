                            "type": "object",
                            "required": [
                              "mean",
                              "valid_years"
                            ],
                            "properties": {
                              "mean": {
                                "$ref": "#/$defs/mean"
                              },
                              "valid_years": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 6
                              }
                            }
                          },
                          {
                            "properties": {
                              "mean": {
                                "properties": {
                                  "maize_deficit_mm": {
                                    "type": "null"
                                  },
                                  "maize_stress_days": {
                                    "type": "null"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  "comparisons": {
                    "type": "object",
                    "required": [
                      "brachiaria_minus_reference_fallow",
                      "soy_long_fallow_minus_reference_fallow"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "brachiaria_minus_reference_fallow": {
