  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "product": {
      "const": "field_shift_strategies"
    },
    "package_id": {
      "type": "string",
      "pattern": "^field-shift-v2-[0-9a-f]{12}$"
    },
    "municipality_code": {
      "type": "string",
      "pattern": "^[0-9]{7}$"
    },
    "simulated": {
      "const": true
    },
    "reference_scenario": {
      "const": "reference_fallow"
    },
    "reference_note": {
      "type": "string"
    },
    "weather": {
      "type": "object",
      "required": [
        "source",
        "agricultural_years",
        "sha256",
        "days",
        "first_day",
        "last_day"
      ]
    },
    "soil": {
      "type": "object",
      "required": [
        "cad_class",
        "capacity_mm",
        "initial_storage_fraction",
        "basis"
      ]
    },
    "scenarios": {
      "type": "object",
      "required": [
        "reference_fallow",
        "brachiaria",
        "soy_long_fallow"
      ],
      "additionalProperties": false,
      "properties": {
        "reference_fallow": {
          "type": "object",
          "required": [
            "mean",
            "valid_years",
            "label",
            "crops",
            "kind",
            "sequence",
            "by_year"
          ],
          "properties": {
            "mean": {
              "$ref": "#/$defs/mean"
            },
            "valid_years": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "label": {
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            "crops": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string"
            },
            "sequence": {
              "type": "string"
            },
            "by_year": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/year"
              }
            }
          }
        },
        "brachiaria": {
          "type": "object",
          "required": [
            "mean",
            "valid_years",
            "label",
            "crops",
            "kind",
            "sequence",
            "by_year"
          ],
          "properties": {
            "mean": {
              "$ref": "#/$defs/mean"
            },
            "valid_years": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "label": {
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            "crops": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string"
            },
            "sequence": {
              "type": "string"
            },
            "by_year": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/year"
              }
            }
          }
        },
        "soy_long_fallow": {
          "allOf": [
            {
              "type": "object",
              "required": [
                "mean",
                "valid_years",
                "label",
                "crops",
                "kind",
                "sequence",
                "by_year"
              ],
              "properties": {
                "mean": {
                  "$ref": "#/$defs/mean"
                },
                "valid_years": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "label": {
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "crops": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "kind": {
                  "type": "string"
                },
                "sequence": {
                  "type": "string"
                },
                "by_year": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/year"
                  }
                }
              }
            },
            {
              "properties": {
                "mean": {
                  "properties": {
                    "maize_deficit_mm": {
                      "type": "null"
                    },
                    "maize_stress_days": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "comparisons": {
      "type": "object",
      "required": [
        "brachiaria_minus_reference_fallow",
        "soy_long_fallow_minus_reference_fallow"
      ],
      "additionalProperties": false,
      "properties": {
        "brachiaria_minus_reference_fallow": {
          "$ref": "#/$defs/comparison"
        },
