                              "maize_deficit_mm": {
                                "properties": {
                                  "status": {
                                    "const": "not_applicable"
                                  }
                                }
                              },
                              "maize_stress_days": {
                                "properties": {
                                  "status": {
                                    "const": "not_applicable"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "parameter",
              "value",
              "scenarios",
              "comparisons"
            ],
            "properties": {
              "scenarios": {
                "type": "object",
                "required": [
                  "reference_fallow",
                  "brachiaria",
                  "soy_long_fallow"
                ],
                "additionalProperties": false,
                "properties": {
                  "reference_fallow": {
                    "type": "object",
                    "required": [
                      "mean",
                      "valid_years"
                    ],
                    "properties": {
                      "mean": {
                        "$ref": "#/$defs/mean"
                      },
                      "valid_years": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                      }
                    }
                  },
                  "brachiaria": {
                    "type": "object",
                    "required": [
                      "mean",
                      "valid_years"
                    ],
                    "properties": {
                      "mean": {
                        "$ref": "#/$defs/mean"
                      },
                      "valid_years": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                      }
