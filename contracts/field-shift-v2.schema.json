{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaiapus.local/contracts/field-shift-v2.schema.json",
  "title": "Gaiapus Field Shift strategies (v2 summary)",
  "description": "Simulated water and soil-presence indicators of three historical management strategies in one municipality, with paired differences and a rain sensitivity test. No yield effect. Absent maize is null, never zero. The v1 contract (field-shift.schema.json) stays valid for the v1 publication.",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "package_id",
    "municipality_code",
    "simulated",
    "reference_scenario",
    "reference_note",
    "sowing",
    "weather",
    "soil",
    "hypotheses",
    "windows",
    "indicator_definitions",
    "scenarios",
    "comparisons",
    "comparisons_note",
    "sensitivity",
    "not_simulated",
    "yield_effect",
    "evidence"
  ],
