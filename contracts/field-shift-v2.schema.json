        "soy_stress_days": {
          "type": "number",
          "minimum": 0
        },
        "year_days": {
          "type": "number",
          "minimum": 0
        },
        "year_rain_mm": {
          "type": "number",
          "minimum": 0
        },
        "year_water_use_mm": {
          "type": "number",
          "minimum": 0
        },
        "year_drainage_mm": {
          "type": "number",
          "minimum": 0
        },
        "post_soy_days": {
          "type": "number",
          "minimum": 0
        },
        "post_soy_water_use_mm": {
          "type": "number",
          "minimum": 0
        },
        "post_soy_drainage_mm": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "maize_status": {
                "const": "not_grown"
              }
            }
          },
          "then": {
            "properties": {
              "maize_sowing": {
                "type": "null"
              },
              "maize_deficit_mm": {
                "type": "null"
              },
              "maize_stress_days": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "maize_sowing": {
                "type": "string"
              },
              "maize_deficit_mm": {
                "type": "number"
              },
              "maize_stress_days": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "stat": {
      "type": "object",
      "required": [
        "n",
        "mean",
        "min",
        "max",
        "years",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "years": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "ok",
            "not_applicable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "n": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "mean": {
                "type": "null"
              },
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "else": {
            "properties": {
              "mean": {
                "type": "number"
              },
              "status": {
                "const": "ok"
              }
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "required": [
        "covered_days",
        "off_season_water_use_mm",
        "off_season_drainage_mm",
        "storage_at_next_sowing_mm",
        "soy_deficit_mm",
