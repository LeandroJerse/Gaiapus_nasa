                "maize_deficit_mm": {
                  "properties": {
                    "status": {
                      "const": "not_applicable"
                    }
                  }
                },
                "maize_stress_days": {
                  "properties": {
                    "status": {
                      "const": "not_applicable"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "comparisons_note": {
      "type": "string"
    },
    "sensitivity": {
      "type": "object",
      "required": [
        "rain",
        "parameters",
        "temperature"
      ],
      "properties": {
        "rain": {
          "type": "object",
          "required": [
            "label",
            "method",
            "points"
          ],
          "properties": {
            "label": {
              "const": "sensitivity test on historical weather, not a climate forecast"
            },
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "multiplier",
                  "rain_change_percent",
                  "scenarios",
                  "comparisons"
                ],
                "properties": {
                  "multiplier": {
                    "enum": [
                      0.8,
                      1.0,
                      1.2
                    ]
                  },
                  "scenarios": {
                    "type": "object",
                    "required": [
                      "reference_fallow",
                      "brachiaria",
                      "soy_long_fallow"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "reference_fallow": {
                        "type": "object",
                        "required": [
                          "mean",
                          "valid_years"
                        ],
                        "properties": {
                          "mean": {
                            "$ref": "#/$defs/mean"
                          },
                          "valid_years": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 6
                          }
                        }
                      },
                      "brachiaria": {
