{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaiapus.local/contracts/yield-estimate.schema.json",
  "title": "Gaiapus yield estimate",
  "description": "Municipal yield at harvest (kg/ha) from data available up to a validated cutoff after sowing (or a coffee milestone). Separate product from the water-risk projection. 1.1.0 adds all v7 crops, season statuses, model scope and the source mode; 1.2.0 adds model.scientific_status and model.historical_reference (display only, no model change); 1.0.0 and 1.1.0 responses stay valid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "status", "generated_at", "municipality_code", "crop", "harvest_year",
               "sowing_date", "sowing_basis", "days_after_sowing_requested", "supported_cutoffs_days", "cutoff_days_used",
               "estimate_kg_ha", "observed_through", "model", "validation", "coverage", "availability", "warnings"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "product": {"const": "yield_estimate"},
    "status": {"enum": ["ready", "before_first_cutoff", "not_supported", "outside_season", "inputs_incomplete"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date", "description": "Date of the request; data are used up to observed_through"},
    "municipality_code": {"type": "string", "pattern": "^[0-9]{7}$"},
    "crop": {"enum": ["soy", "maize2", "maize1", "wheat", "rice", "bean1", "bean2", "coffee_arabica", "coffee_conilon", "coffee_total_mg"]},
    "harvest_year": {"type": "integer", "minimum": 2002},
    "milestone": {"type": ["string", "null"], "description": "Coffee milestone (pre_flowering, post_flowering, grain_filling) or day_<n> for annual crops"},
    "sowing_date": {"type": "string", "format": "date", "description": "For coffee: start of the production year (1 June of the year before harvest)"},
    "sowing_basis": {"enum": ["hypothetical_fixed_calendar_per_state", "reported_by_user", "coffee_production_year_start"],
                     "description": "Origin of sowing_date. The models were validated on the state calendar; a reported date shifts the features (see calendar sensitivity)"},
    "days_after_sowing_requested": {"type": "integer", "minimum": 0},
    "supported_cutoffs_days": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 15}},
    "cutoff_days_used": {"type": ["integer", "null"], "description": "Largest validated cutoff not after the requested day"},
    "estimate_kg_ha": {"type": ["number", "null"], "minimum": 0},
    "observed_through": {"type": ["string", "null"], "format": "date", "description": "Last day of data the estimate used"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "type", "sources", "artifact_sha256", "trained_through_harvest"],
      "properties": {
        "version": {"type": "string"},
        "type": {"enum": ["baseline", "reference", "ridge", "hgb", "mlp"]},
        "name": {"type": "string", "description": "sources+model, e.g. site+mlp"},
        "scope": {"type": "string", "description": "national or a frozen regional rule, e.g. MG+MT"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trained_through_harvest": {"type": "integer"},
        "scientific_status": {"enum": ["confirmed_on_2022_2024_test", "not_confirmed_on_2022_2024_test",
                                       "worse_than_history_on_2022_2024_test", "not_tested"],
                              "description": "Single 2022-2024 test of the served model against the history reference. Not an operational validation; no served model is released for operational use."},
        "historical_reference": {
          "type": "object", "additionalProperties": false, "required": ["name", "description"],
          "properties": {
            "name": {"const": "history"},
            "description": {"type": "string"},
            "test_2022_2024_mae_kg_ha": {"type": ["number", "null"]},
            "served_model_test_2022_2024_mae_kg_ha": {"type": ["number", "null"]}
          }
        }
      }
    },
    "validation": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["years", "cutoff_days", "mae_kg_ha", "bias_kg_ha", "label_families", "municipalities", "scope"],
      "properties": {
        "years": {"type": "array", "items": {"type": "integer"}},
        "cutoff_days": {"type": "integer"},
        "mae_kg_ha": {"type": "number", "minimum": 0},
        "bias_kg_ha": {"type": "number"},
        "label_families": {"type": "integer", "minimum": 1},
        "municipalities": {"type": "integer", "minimum": 1},
        "scope": {"type": "string"},
        "validation_status": {"enum": ["validated", "experimental", "reference_only"]},
        "test_2022_2024": {
          "type": "object", "additionalProperties": false, "required": ["mae_kg_ha", "history_mae_kg_ha", "outcome"],
          "properties": {"mae_kg_ha": {"type": "number"}, "history_mae_kg_ha": {"type": "number"},
                         "ci95": {"type": "array", "items": {"type": "number"}},
                         "outcome": {"enum": ["confirmed", "not_confirmed", "worse_than_history"]}},
          "description": "Single evaluation on harvests 2022-2024 of the frozen choice, all cutoffs pooled"
        },
        "out_of_training_municipalities": {
          "type": "object", "additionalProperties": false, "required": ["mae_kg_ha", "label_families"],
          "properties": {"mae_kg_ha": {"type": "number"}, "label_families": {"type": "integer"}}
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["forcing_days_expected", "forcing_days_present", "sources"],
      "properties": {
        "forcing_days_expected": {"type": "integer", "minimum": 0},
        "forcing_days_present": {"type": "integer", "minimum": 0},
        "sources": {"type": "array", "items": {"type": "string"}},
        "source_mode": {"enum": ["retrospective", "operational"]}
      }
    },
    "availability": {"enum": ["retrospective_inputs_vintages_unverified", "operational_sources_validated_retrospectively"]},
    "operational_release": {"const": "not_released"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ready"}}},
     "then": {"properties": {"estimate_kg_ha": {"type": "number"}, "cutoff_days_used": {"type": "integer"}, "validation": {"type": "object"}}}},
    {"if": {"properties": {"status": {"not": {"const": "ready"}}}},
     "then": {"properties": {"estimate_kg_ha": {"type": "null"}, "validation": {"type": "null"}}}}
  ]
}
